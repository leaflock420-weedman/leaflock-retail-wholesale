# Australia Post postage estimates (admin only)
AUSPOST_PAC_API_KEY=
AUSPOST_FROM_POSTCODE=4217

# Bank (shown on invoices — defaults in code if unset)
BANK_ACCOUNT_NAME=LL PYT LTD
BANK_BSB=734216
BANK_ACCOUNT_NUMBER=
BANK_PAY_ID=

# Site
SITE_URL=https://www.wholesale.leaflock.com.au
