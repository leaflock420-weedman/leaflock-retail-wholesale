# Copy to .env.local for local dev only — NEVER commit real values to GitHub.
# Production secrets live on Render → leaflock-retail-wholesale → Environment.

# Admin & sessions
ANALYTICS_ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
PORTAL_SESSION_SECRET=
PORTAL_CODE_SALT=
PORTAL_PASSWORD_PEPPER=

# Email (info@leaflock.com.au)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
WHOLESALE_EMAIL_TO=info@leaflock.com.au
ANALYTICS_EMAIL_FROM=info@leaflock.com.au
ANALYTICS_EMAIL_TO=info@leaflock.com.au

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
